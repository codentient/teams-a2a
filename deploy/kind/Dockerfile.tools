# Dev/test tools: the kagent-like demo agent and the Teams/Bot Service simulator.
FROM golang:1.27 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/demo-agent ./cmd/demo-agent && CGO_ENABLED=0 go build -o /out/teams-sim ./cmd/teams-sim
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/ /usr/local/bin/
